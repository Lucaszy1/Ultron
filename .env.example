# Copy to .env and fill in. .env is gitignored.

# Required: your Anthropic API key (https://console.anthropic.com/)
ANTHROPIC_API_KEY=sk-ant-...

# Optional: require this token (sent as the X-App-Token header) on POST
# requests so a stranger who reaches the server can't spend your API credits.
ULTRON_APP_TOKEN=

# Optional overrides
ULTRON_MODEL=claude-sonnet-4-5
FLASK_DEBUG=0
HOST=127.0.0.1
PORT=5001
